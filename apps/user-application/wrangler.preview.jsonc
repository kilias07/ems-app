{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ems-app-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/trpc/*"]
  },

  "observability": {
    "enabled": true
  },

  "routes": [
    { "pattern": "preview.ems-ranking.pl", "custom_domain": true }
  ],

  "vars": {
    "FROM_EMAIL": "noreply@ems-ranking.pl",
    "AVATAR_PUBLIC_URL": "https://pub-00448ca903c5490f970f5e819fdde287.r2.dev"
  },

  "send_email": [
    { "name": "EMAIL" }
  ],

  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "ems-avatars-preview" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ems-studio-db-preview",
      "database_id": "d8f5c10c-dec9-4c38-8479-f5a7f5d586d5",
      "migrations_dir": "../../packages/data-ops/src/drizzle-out"
    }
  ]
}
