{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ems-app-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2025-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/trpc/*"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "RESEND_FROM_EMAIL": "noreply@ems360.pl"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ems-studio-db-preview",
      "database_id": "d8f5c10c-dec9-4c38-8479-f5a7f5d586d5",
      "migrations_dir": "../../packages/data-ops/src/drizzle-out"
    }
  ]
}
